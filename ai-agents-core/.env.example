# Token Pessoal ou de Repositorio do GitHub (com permissao de escrita)
GITHUB_TOKEN=ghp_seu_token_aqui

# Token gerado no Google AI Studio
GEMINI_API_KEY=AIzaSy_seu_token_aqui

# Token gerado na aba Integrations da sua conta no Notion
NOTION_API_KEY=secret_seu_token_aqui

# O ID extraido da URL da pagina/database de tarefas no Notion
NOTION_TASK_ID=123abc_seu_id_aqui

# Nome exato do repositorio alvo (ex: usuario/SolveTechAi---Concent)
GITHUB_REPOSITORY=usuario/SolveTechAi---Concent

# Responsavel vinculado as tasks no Notion e aprovador exclusivo dos PRs
USER_OWNER_NAME=João Vitor Novaes
